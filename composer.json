{
	"name": "pfefferle/wordpress-host-meta",
	"description": "Helps other apps and services find out what your site offers.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/pfefferle/wordpress-host-meta",
	"authors": [
		{
			"name": "Matthias Pfefferle",
			"homepage": "https://notiz.blog"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9",
		"phpcompatibility/php-compatibility": "*",
		"phpcompatibility/phpcompatibility-wp": "*",
		"squizlabs/php_codesniffer": "3.*",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^4.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
		"sirbrillig/phpcs-variable-analysis": "^3.0",
		"phpcsstandards/phpcsextra": "^1.1.0"
	},
	"extra": {
		"installer-name": "host-meta"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	},
	"scripts": {
		"test": [
			"composer install",
			"bin/install-wp-tests.sh host-meta-test root host-meta-test test-db latest true",
			"vendor/bin/phpunit"
		],
		"test:wp-env": [
			"wp-env run tests-cli --env-cwd=\"wp-content/plugins/host-meta\" vendor/bin/phpunit"
		],
		"lint": [
			"vendor/bin/phpcs"
		],
		"lint:fix": [
			"vendor/bin/phpcbf"
		]
	}
}
